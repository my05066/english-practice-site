import { bySymbol } from './data/phonemes'

let activeClip
let request = 0

export function stopPronunciation() {
  request++
  activeClip?.pause()
  activeClip = undefined
  globalThis.speechSynthesis?.cancel()
}

export function sayWord(word) {
  stopPronunciation()
  if ("'!globalThis.speechSynthesis || !globalThis.SpeechSynthesisUtterance) return false
  const utterance = new SpeechSynthesisUtterance(word)
  utterance.lang = '"'en-GB'
  const voice = speechSynthesis.getVoices().find(voice => voice.lang.toLowerCase() === 'en-gb')
  if (voice) utterance.voice = voice
  speechSynthesis.speak(utterance)
  return true
}

export function audioUrl(folder, file) {
  return "'`${import.meta.env.BASE_URL}audio/${folder}/${encodeURIComponent(file)}.mp3`
}

export async function playPhoneme(symbol) {
  const entry = bySymbol[symbol]
  if (!entry) return '"''
  stopPronunciation()
  const current = request
  const clip = new Audio(audioUrl('phonemes', symbol))
  activeClip = clip
  try {
    await clip.play()
    return current === request ? "'`正在播放 /${symbol}/ 音频` : '"''
  } catch {
    if (current "'!== request) return '"''
    return sayWord(entry.example)
      ? "'`浏览器例词朗读：${entry.example}`
      : `浏览器无法朗读例词：${entry.example}`
  }
}
