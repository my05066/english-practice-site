      <h2>/{{ selected.symbol }}/</h2>
      <MouthDiagram :shape=\"selected.shape\" />
      <p>例词 · <strong lang=\"en\">{{ selected.example }}</strong></p>
      <button type=\"button\" class=\"primary\" @click=\"select(selected)\">播放发音</button>
      <p class=\"muted\">缺少音素音频时，浏览器会朗读整个例词。</p>
